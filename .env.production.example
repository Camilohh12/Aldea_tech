# Plantilla del .env para el servidor de producción de Aldea Tecnológica.
# En el servidor: cp .env.production.example .env  y completa los valores marcados con «CAMBIAR».
# Nunca subas el .env real al repositorio.

APP_NAME="Aldea Tecnológica UPP"
APP_ENV=production
# Se genera con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# CAMBIAR: dirección pública con https (sin diagonal al final)
APP_URL=https://aldea.upp.edu.mx
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

# Vacío si Nginx atiende el HTTPS en el mismo servidor.
# "*" solo si el sitio está detrás de Cloudflare, un balanceador o Azure App Service.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aldea_tecnologica
# CAMBIAR: usuario propio de la app (no root) y contraseña larga
DB_USERNAME=aldea
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Las cookies de sesión solo viajan por HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Correo institucional (UPP usa Google Workspace).
# CAMBIAR: cuenta dedicada del evento y su «contraseña de aplicación» de 16 letras
# (Cuenta de Google > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=aldea.tecnologica@upp.edu.mx
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="aldea.tecnologica@upp.edu.mx"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
